{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Darts7u7/Yarah-oos-mcp",
  "title": "Yarah",
  "description": "MCP server for Yarah BaaS — database, storage, edge functions, and deployments",
  "websiteUrl": "https://yarah.dev",
  "icons": [
    {
      "src": "https://github.com/Darts7u7.png",
      "mimeType": "image/png"
    }
  ],
  "repository": {
    "url": "https://github.com/Darts7u7/Yarah-oos-mcp",
    "source": "github"
  },
  "version": "1.2.12",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.yarah.dev/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@yarahdev/mcp",
      "version": "1.2.12",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "API_KEY",
          "description": "Yarah project API key",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "API_BASE_URL",
          "description": "Yarah backend URL (e.g. https://your-app.us-east.apps.yarah.dev)",
          "isRequired": true
        }
      ]
    }
  ]
}
